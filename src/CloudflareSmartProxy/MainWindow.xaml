<Window
    x:Class="CloudflareSmartProxy.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="IPOptimize - 智能 IP 优选加速工具"
    Width="1240"
    Height="820"
    MinWidth="1020"
    MinHeight="680"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--  CDN 行：状态灯颜色由 StatusKind 映射  -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="#9AA0A6" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                    <Setter Property="Fill" Value="#107C10" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                    <Setter Property="Fill" Value="#C56A00" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="err">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="run">
                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  池表里的数字：为 0 时标红  -->
        <Style x:Key="PoolCountStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EdgeCount}" Value="0">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="智能IP优选加速" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12.5"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="Cloudflare · CloudFront · Github IP优选加速" />
            </StackPanel>

            <!--  ============ 顶部公告位（标题右边，跟标题同一行，不单独占一行） ============
                  开窗时拉一次公告 JSON（image + link），把图片放进这个可点击的 Border 里，点击用系统浏览器打开链接
                  （认浏览器 exe 的逻辑在 Services\BrowserLauncher.cs，实现见 MainWindow.Promo.cs）。
                  图片 Stretch=Uniform：按 60 高保比例完整显示，宽度上限 700（宽过头才缩到 700 并上下留白，绝不裁切变形；
                  线上那张 500×60 在 60 高下正好 1:1）。Border 靠 HorizontalAlignment=Center 在这列里居中，
                  它的宽度＝缩放后图片的宽度，所以叉号贴在图片自身的右上角。
                  Background="Transparent" 是必须的：整块都要能命中点击，图片自身的透明像素否则会让点击穿透过去。
                  拉不到（网络失败 / JSON 非法 / 缺字段 / 图过大 / 解码失败）就整块 Collapsed——原生控件判得出成败，
                  不像当初那个 WebBrowser 只能常驻；收起不占位、不弹框、不轮询不重试。
                  右上角那个叉号（PromoClose）只收起本次运行的公告：不写 settings.json，下次开窗照样取。-->
            <Border
                x:Name="PromoBanner"
                Grid.Column="1"
                Height="60"
                MaxWidth="700"
                Margin="0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                Cursor="Hand"
                Visibility="Collapsed"
                MouseLeftButtonUp="PromoBanner_Click">
                <Grid>
                    <Image
                        x:Name="PromoImage"
                        Stretch="Uniform"
                        SnapsToDevicePixels="True" />

                    <!-- 右上角叉号：只把本次运行的公告收起来，不写 settings.json（下次开窗还会取）。
                         Background 必须走 Style 的 Setter（不是元素上的局部值），否则下面的 IsMouseOver
                         触发器会被局部值压住、悬停没有反馈。 -->
                    <Border
                        x:Name="PromoClose"
                        Width="16"
                        Height="16"
                        Margin="0,2,2,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        CornerRadius="8"
                        Cursor="Hand"
                        ToolTip="关闭公告（本次运行不再显示）"
                        MouseLeftButtonUp="PromoClose_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#66000000" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#CC000000" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontFamily="Segoe UI"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="&#xD7;" />
                    </Border>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="12,6"
                VerticalAlignment="Center"
                Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse
                        x:Name="StatusDot"
                        Width="9"
                        Height="9"
                        Margin="0,0,8,0"
                        Fill="#9AA0A6" />
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        Text="IP优选未启动" />
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="1" Margin="0,10,0,0">
            <TabItem Header="优选CDN">
                <DockPanel Margin="0,6,0,0">
                    <Border
                        Margin="0,0,0,10"
                        DockPanel.Dock="Top"
                        Style="{StaticResource TipBar}">
                        <TextBlock
                            FontSize="12.5"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            TextWrapping="Wrap"
                            Text="提示：本功能只优化 Cloudflare 与 Amazon CloudFront 这两个 CDN 的域名——测出它们当前最快的边缘 IP；其它域名不受影响，仍按系统 DNS 解析。" />
                    </Border>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  ============ 参数区：左 CDN 列表 / 右 共享参数 + 当前 CDN ============  -->
                        <Border
                            Margin="0,0,0,12"
                            Padding="18"
                            Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="216" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  左：CDN 档位列表  -->
                                <DockPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        DockPanel.Dock="Top"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        Text="CDN（勾选＝纳入本次测速）" />
                                    <ListBox
                                        x:Name="CdnList"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{Binding CdnProfiles}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        SelectedItem="{Binding SelectedCdn, Mode=TwoWay}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="8,6" />
                                                <Setter Property="Margin" Value="0,0,0,2" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox
                                                        Margin="0,2,8,0"
                                                        VerticalAlignment="Top"
                                                        IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>

                                <!--  右：共享参数（保持原有全部字段）+ 当前 CDN 专属  -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        FontWeight="SemiBold"
                                        Text="共享参数（对所有 CDN 生效）" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                Text="每网段采样" />
                                            <TextBox
                                                x:Name="SamplesTextBox"
                                                Width="92"
                                                HorizontalAlignment="Left"
                                                Text="8" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                Text="优选IP数量" />
                                            <TextBox
                                                x:Name="OptimizationCountTextBox"
                                                Width="92"
                                                HorizontalAlignment="Left"
                                                Text="10" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Bottom">
                                            <TextBlock
                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                Text="（其余共享参数在下方「测速选项（高级）」内，与原来一致）"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <!--  测速高级选项：默认折叠。TCPing 一条测速路径 + 下载测速的参数；
                                          原 HTTPing 相关（模式开关、HTTP 状态码、HTTP 超时、匹配地区码）与惰性的
                                          「全量测速 / 禁用下载测速 / 跳过证书校验」已从界面与设置里删除。  -->
                                    <Expander
                                        Margin="0,10,0,0"
                                        Header="测速选项（高级）"
                                        IsExpanded="False">
                                        <ScrollViewer Height="190">
                                            <Grid Margin="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="0,4"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="120"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="线程并发数:" />
                                                    <TextBox x:Name="RoutinesTextBox" Width="80" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="（默认 200 最多 1000）" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Margin="0,4"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="120"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="Ping 次数:" />
                                                    <TextBox x:Name="PingTimesTextBox" Width="80" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="（单个 IP 延迟测速的次数）" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Margin="0,4"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="120"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="下载最长(秒):" />
                                                    <TextBox x:Name="DownloadTimeTextBox" Width="80" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Margin="0,4"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="120"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="测速端口:" />
                                                    <TextBox x:Name="SpeedPortTextBox" Width="80" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="（默认443）" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Margin="0,4"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="120"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="延时下限(ms):" />
                                                    <TextBox x:Name="MinDelayTextBox" Width="80" />
                                                    <TextBlock
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="延时上限(ms):" />
                                                    <TextBox x:Name="MaxDelayTextBox" Width="80" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Margin="0,4"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="120"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="最大丢包率:" />
                                                    <TextBox x:Name="MaxLossRateTextBox" Width="80" />
                                                    <TextBlock
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="最小速度(MB/s):" />
                                                    <TextBox x:Name="MinSpeedTextBox" Width="80" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Margin="0,4"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="120"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="连接超时(ms):" />
                                                    <TextBox x:Name="ConnectTimeoutTextBox" Width="80" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="（TCPing 单次建连上限）" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    Margin="0,4"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="120"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        Text="下载并发数:" />
                                                    <TextBox x:Name="DownloadConcurrencyTextBox" Width="80" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Row="4"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,12,0,0"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal">
                                                    <Button
                                                        Margin="0,0,8,0"
                                                        Click="SaveSpeedOptions_Click"
                                                        Content="保存测速选项" />
                                                    <Button Click="ResetSpeedOptions_Click" Content="重置为默认" />
                                                </StackPanel>
                                            </Grid>
                                        </ScrollViewer>
                                    </Expander>

                                    <!--  当前 CDN 专属参数（跟随左栏选中项）  -->
                                    <Border
                                        Margin="0,12,0,0"
                                        Padding="14,12"
                                        Background="{StaticResource NestedCardBackgroundBrush}"
                                        DataContext="{Binding SelectedCdn}"
                                        Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontSize="14"
                                                    FontWeight="SemiBold">
                                                    <Run Text="当前 CDN：" /><Run Text="{Binding Name, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="11.5"
                                                    Foreground="{StaticResource SecondaryTextBrush}"
                                                    Text="{Binding StatusText, Mode=OneWay}" />
                                            </Grid>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="88" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="0,0,0,8"
                                                    Style="{StaticResource FieldLabelStyle}"
                                                    Text="测速地址" />
                                                <TextBox
                                                    x:Name="SpeedUrlTextBox"
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Margin="0,0,0,8"
                                                    Text="{Binding SpeedTestUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  ============ 测速入口 + 整体进度 ============  -->
                        <Border
                            Grid.Row="1"
                            Margin="0,0,0,12"
                            Padding="18,14"
                            Style="{StaticResource Card}">
                            <StackPanel>
                                <WrapPanel>
                                    <Button
                                        x:Name="OptimizeButton"
                                        Margin="0,0,8,0"
                                        Click="OptimizeButton_Click"
                                        Content="测速当前 CDN"
                                        Style="{StaticResource AccentButton}" />
                                    <Button
                                        x:Name="RunSelectedButton"
                                        Margin="0,0,8,0"
                                        Click="BatchTest_Click"
                                        Content="测速勾选的 CDN" />
                                    <Button
                                        x:Name="StopTestButton"
                                        Click="StopTest_Click"
                                        Content="停止"
                                        IsEnabled="False"
                                        Style="{StaticResource DangerButton}" />
                                </WrapPanel>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar
                                        x:Name="OverallProgress"
                                        Grid.Column="0"
                                        Height="18"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="0" />
                                    <TextBlock
                                        x:Name="BatchStatusText"
                                        Grid.Column="1"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        Text="空闲" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  ============ 结果 + 日志 ============  -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                Padding="16"
                                Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="优选结果：" />
                                        <ComboBox
                                            x:Name="CdnFilterComboBox"
                                            Grid.Column="1"
                                            Width="150"
                                            HorizontalAlignment="Left"
                                            SelectionChanged="CdnFilterComboBox_SelectionChanged" />
                                        <Button
                                            Grid.Column="2"
                                            MinWidth="112"
                                            Click="AddToProxy_Click"
                                            Content="添加到IP优选"
                                            Style="{StaticResource AccentButton}" />
                                    </Grid>

                                    <DataGrid
                                        x:Name="ResultsGrid"
                                        Grid.Row="1"
                                        Margin="0,12,0,0"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        HeadersVisibility="Column"
                                        IsReadOnly="False"
                                        ItemsSource="{Binding TestResults}"
                                        SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn
                                                Width="40"
                                                Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Header="" />
                                            <DataGridTextColumn
                                                Width="128"
                                                Binding="{Binding Cdn}"
                                                Header="CDN"
                                                IsReadOnly="True" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Ip}"
                                                Header="IP" />
                                            <DataGridTextColumn
                                                Width="80"
                                                Binding="{Binding LossRate}"
                                                Header="丢包率" />
                                            <DataGridTextColumn
                                                Width="100"
                                                Binding="{Binding AvgDelayMs}"
                                                Header="平均延迟（ms）" />
                                            <DataGridTextColumn
                                                Width="120"
                                                Binding="{Binding SpeedMBs}"
                                                Header="下载速度（MB/s）" />
                                            <DataGridTextColumn
                                                Width="90"
                                                Binding="{Binding Colo}"
                                                Header="地区码" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="16"
                                Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Text="筛选日志" />
                                    <ListBox
                                        x:Name="LogList"
                                        Grid.Row="1"
                                        Margin="0,12,0,0"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="12"
                                        ItemsSource="{Binding Logs}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem
                Height="20"
                VerticalAlignment="Top"
                Header="优选DNS">
                <DockPanel Margin="0,6,0,0">
                    <Border
                        Margin="0,0,0,10"
                        DockPanel.Dock="Top"
                        Style="{StaticResource TipBar}">
                        <TextBlock
                            FontSize="12.5"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            TextWrapping="Wrap"
                            Text="提示：本功能主要解决 GitHub 这类在国内访问困难的域名——用扫出来的公共 DNS 加速池重新解析，保证访问速度和稳定性。" />
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76*" />
                            <ColumnDefinition Width="517*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  ============ 扫描参数 ============  -->
                        <Border
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,168"
                            Padding="18,14"
                            Style="{StaticResource Card}">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        Text="目标域名：" />
                                    <TextBox
                                        x:Name="DnsDomainTextBox"
                                        Width="200"
                                        Margin="6,0,0,0"
                                        Text="github.com" />
                                    <Button
                                        x:Name="DnsScanButton"
                                        Margin="10,0,0,0"
                                        Click="DnsScanButton_Click"
                                        Content="开始扫描"
                                        Style="{StaticResource AccentButton}" />
                                    <Button
                                        x:Name="DnsScanStopButton"
                                        Margin="8,0,0,0"
                                        Click="DnsScanStopButton_Click"
                                        Content="停止"
                                        IsEnabled="False" />
                                    <TextBlock
                                        Margin="18,0,6,0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        Text="并发数：" />
                                    <TextBox
                                        x:Name="DnsScanConcurrencyTextBox"
                                        Width="64"
                                        Text="128" />
                                    <TextBlock
                                        Margin="12,0,6,0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        Text="超时(ms)：" />
                                    <TextBox
                                        x:Name="DnsScanTimeoutTextBox"
                                        Width="72"
                                        Text="2000" />
                                </WrapPanel>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar
                                        x:Name="DnsScanProgressBar"
                                        Height="18"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="0" />
                                    <TextBlock
                                        x:Name="DnsScanStatusText"
                                        Grid.Column="1"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        Text="尚未扫描。DNS 列表优先从网上取（取不到就用本地缓存，再退回内置的约 1200 条），扫描会并发解析目标域名并测出每个 DNS 的响应延迟。" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  ============ 加速池操作 ============  -->
                        <Border
                            Grid.ColumnSpan="2"
                            Margin="0,104,0,74"
                            Padding="18,12"
                            Style="{StaticResource Card}">
                            <StackPanel>
                                <WrapPanel>
                                    <Button
                                        x:Name="DnsApplyPoolButton"
                                        Click="DnsApplyPoolButton_Click"
                                        Content="应用到 DNS 加速池"
                                        IsEnabled="False"
                                        Style="{StaticResource AccentButton}" />
                                    <Button
                                        x:Name="DnsClearPoolButton"
                                        Margin="8,0,0,0"
                                        Click="DnsClearPoolButton_Click"
                                        Content="清空加速池" />
                                    <Button
                                        x:Name="DnsExportReportButton"
                                        Margin="8,0,0,0"
                                        Click="DnsExportReportButton_Click"
                                        Content="导出扫描结果"
                                        IsEnabled="False" />
                                    <Button
                                        x:Name="DnsExportListButton"
                                        Margin="8,0,0,0"
                                        Click="DnsExportListButton_Click"
                                        Content="导出 DNS 列表模板" />
                                </WrapPanel>
                                <TextBlock
                                    x:Name="DnsPoolStatusText"
                                    Margin="0,8,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="DNS 加速池：空" />
                            </StackPanel>
                        </Border>

                        <!--  ============ 扫描结果（按 IP 分组） ============  -->
                        <Border
                            Grid.RowSpan="3"
                            Grid.ColumnSpan="2"
                            Margin="0,198,0,0"
                            Padding="16"
                            Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="扫描结果（按 IP 组最快延迟、组内延迟升序排列）" />
                                <DataGrid
                                    x:Name="DnsScanGrid"
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="150"
                                            Binding="{Binding Ip}"
                                            Header="解析出的 IP" />
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding DnsServer}"
                                            Header="DNS 服务器" />
                                        <DataGridTextColumn
                                            Width="220"
                                            Binding="{Binding DnsName}"
                                            Header="归属" />
                                        <DataGridTextColumn
                                            Width="100"
                                            Binding="{Binding LatencyMs}"
                                            Header="延迟（ms）" />
                                        <DataGridTextColumn
                                            Width="140"
                                            Binding="{Binding GroupCount}"
                                            Header="该 IP 可用 DNS 数" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock
                                    x:Name="DnsScanSummaryText"
                                    Grid.Row="2"
                                    Margin="0,8,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="" />
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem
                Height="20"
                VerticalAlignment="Top"
                Header="开始优化">
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="11*" />
                        <ColumnDefinition Width="582*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.ColumnSpan="2"
                        Padding="12"
                        Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="代理端口" />
                                <TextBox
                                    x:Name="PortTextBox"
                                    Width="82"
                                    Text="7890" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="代理控制" />
                                <Button
                                    x:Name="ProxyButton"
                                    MinWidth="108"
                                    Click="ProxyButton_Click"
                                    Content="启动优选加速"
                                    Style="{StaticResource AccentButton}" />
                                <!--  勾选后面那行灰字＝一句话备注（完整规则仍在 ToolTip 里）；用横向 StackPanel 包着，别把备注写进 Content，那样点备注也会把勾打上  -->
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <CheckBox
                                        x:Name="CdnOptimizeCheckBox"
                                        Content="优选CDN"
                                        IsChecked="True"
                                        ToolTip="勾选后必须有 CDN 优选 IP 才允许启动代理；取消勾选则本次运行不使用任何 CDN 优选池（CDN 域名走原始 DNS）。" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        Text="应用于Cloudflare/CloudFront加速的网站和资源" />
                                </StackPanel>
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <CheckBox
                                        x:Name="DnsOptimizeCheckBox"
                                        Content="优选DNS"
                                        IsChecked="True"
                                        ToolTip="勾选后必须有 DNS 加速池才允许启动代理；若同时启用了 HTTPS 解密（MITM）而根证书未安装，会在这里提示安装。取消勾选则本次运行不做 DNS 加速与解密。" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        Text="应用于Github" />
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <Grid
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="400" />
                        </Grid.ColumnDefinitions>
                        <!--
                            两行：上＝各 CDN 加速池 + 优选列表（*，会被下面的 DNS 加速池挤），下＝DNS 加速池横跨这两列。
                            右边「优选实时日志」跨这两行，所以 Expander 展开不影响它的高度。
                        -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  各 CDN 加速池概览  -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            Padding="12"
                            Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="各 CDN 加速池" />
                                <ListBox
                                    x:Name="PoolList"
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding CdnProfiles}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="206">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource PoolCountStyle}"
                                                    Text="{Binding EdgeCountText}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="8,0,0,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{StaticResource SecondaryTextBrush}"
                                                    Text="{Binding LastRunText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,8,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="IP 数＝代理列表中该 CDN 的条目数" />
                            </Grid>
                        </Border>

                        <!--  代理列表（按 CDN 分组）  -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            Padding="12"
                            Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Text="优选列表" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button
                                            MinWidth="76"
                                            Margin="0"
                                            Click="ClearProxyList_Click"
                                            Content="清空"
                                            Style="{StaticResource DangerButton}" />
                                    </StackPanel>
                                </Grid>
                                <DataGrid
                                    x:Name="ProxyGrid"
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding ProxyList}">
                                    <DataGrid.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.ContainerStyle>
                                                <Style TargetType="GroupItem">
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                </Style>
                                            </GroupStyle.ContainerStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Padding="9,4"
                                                        Background="{StaticResource GridHeaderBackgroundBrush}"
                                                        BorderBrush="{StaticResource CardBorderBrush}"
                                                        BorderThickness="0,0,0,1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                            <TextBlock
                                                                Margin="6,0,0,0"
                                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                                Text="{Binding ItemCount, StringFormat='  {0} 个'}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </DataGrid.GroupStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding Ip}"
                                            Header="IP" />
                                        <DataGridTextColumn
                                            Width="90"
                                            Binding="{Binding Colo}"
                                            Header="地区码" />
                                        <DataGridTemplateColumn Width="60" Header="操作">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        MouseLeftButtonUp="DeleteProxyRow_Click"
                                                        Text="删除"
                                                        ToolTip="从代理列表移除该 IP" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!--  优选实时日志：跨两行，DNS 加速池展开不会压缩它  -->
                        <Border
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Padding="12"
                            Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="优选实时日志" />
                                <ListBox
                                    x:Name="ProxyLogList"
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    ItemsSource="{Binding Logs}" />
                            </Grid>
                        </Border>

                        <!--
                            DNS 加速池：CDN 池与优选列表下面那张横卡（横跨这两列），默认折叠。
                            展开只挤压上面两张卡，右边「优选实时日志」跨两行、高度不变。
                            横卡够宽，所以明细用换行的多列紧凑行（IP · 归属 · 延迟），归属太长看 ToolTip。
                        -->
                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,12,8,0"
                            Padding="12,4"
                            Style="{StaticResource Card}">
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel>
                                        <TextBlock
                                            x:Name="DnsPoolSummaryText"
                                            FontWeight="SemiBold"
                                            Text="DNS 加速池：空" />
                                        <TextBlock
                                            x:Name="DnsPoolSummarySubText"
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="白名单域名将回退系统 DNS"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander.Header>
                                <ListBox
                                    x:Name="DnsPoolList"
                                    MaxHeight="150"
                                    Margin="0,8,0,4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="11.5"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Width="230"
                                                Margin="0,1,12,1"
                                                ToolTip="{Binding RowTip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontFamily="Cascadia Mono, Consolas"
                                                    Text="{Binding Ip}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="6,0"
                                                    Foreground="{StaticResource SecondaryTextBrush}"
                                                    Text="{Binding Display}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Foreground="{StaticResource SecondaryTextBrush}"
                                                    Text="{Binding LatencyMs, StringFormat={}{0}ms}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Expander>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border
                            MaxWidth="880"
                            Margin="4,12"
                            Padding="18,16"
                            HorizontalAlignment="Left"
                            Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="DNS 加速域名白名单（GlobalDns）" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="仅白名单内的「非 CDN 域名」会走 DNS 加速：用「优选DNS」页扫出的加速池并发解析 + 多 IP 竞速，而不是回退系统 DNS；属于已接入 CDN 的域名仍走各自的优选 IP 池，其余域名仍走原始 DNS。条目以逗号 / 分号 / 换行分隔，支持 * 通配符：*.example.com 匹配所有子域名，example.com 只匹配自身，单独的 * 匹配全部；大小写不敏感。内置的 GitHub 域名（github.com、*.githubusercontent.com、ghcr.io 等）会始终保留——删掉也会被合回来，要整体停用请取消下面「启用 DNS 加速池解析 + 多 IP 竞速」的勾选。"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    x:Name="GlobalDnsWhitelistTextBox"
                                    Height="180"
                                    Margin="0,12,0,0"
                                    VerticalContentAlignment="Top"
                                    AcceptsReturn="True"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12.5"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Click="SaveSettings_Click" Content="保存设置" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!--  ============ DNS 加速 / 竞速 / MITM 参数 ============  -->
                        <Border
                            MaxWidth="880"
                            Margin="4,0,4,12"
                            Padding="18,16"
                            HorizontalAlignment="Left"
                            Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="DNS 加速" />
                                <CheckBox
                                    x:Name="DnsAccelEnabledCheckBox"
                                    Margin="0,12,0,0"
                                    Content="启用 DNS 加速池解析 + 多 IP 竞速（仅作用于上面的白名单域名）" />
                                <CheckBox
                                    x:Name="MitmEnabledCheckBox"
                                    Margin="0,6,0,0"
                                    Content="对白名单域名的 HTTPS 解密，以便逐请求并发竞速（需安装本地根证书）" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="不勾选解密时，白名单 HTTPS 仍是端到端加密的透明隧道，只是接入点换成竞速胜出的 IP；勾选后代理会用本地根证书签发域名证书与浏览器握手，因此浏览器必须信任该根证书，否则 HTTPS 会报证书错误。"
                                    TextWrapping="Wrap" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,4"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="170"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="竞速每批并发 IP 数:" />
                                        <TextBox x:Name="RaceMaxIpsTextBox" Width="64" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,4"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="170"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="解析缓存 TTL 下限(秒):" />
                                        <TextBox x:Name="DnsTtlMinTextBox" Width="64" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,4"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="170"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="请求体缓冲上限(MB):" />
                                        <TextBox x:Name="RaceBodyLimitTextBox" Width="64" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,4"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="缓存 TTL 上限(秒):" />
                                        <TextBox x:Name="DnsTtlMaxTextBox" Width="64" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,4"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="170"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="竞速建连超时(ms):" />
                                        <TextBox x:Name="RaceConnectTimeoutTextBox" Width="64" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="0,4"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="每批竞速预算(ms):" />
                                        <TextBox x:Name="RaceBatchBudgetTextBox" Width="64" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Margin="0,4"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="170"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="MITM 建连超时(ms):" />
                                        <TextBox x:Name="MitmConnectTimeoutTextBox" Width="64" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Margin="0,4"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="MITM 解密端口:" />
                                        <TextBox
                                            x:Name="MitmPortsTextBox"
                                            Width="110"
                                            ToolTip="逗号分隔的 CONNECT 端口，只有落在这个列表里的端口才会尝试解密；默认 443，可按需写 443,8443" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Margin="0,4"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="170"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="全失败后重赛轮数:" />
                                        <TextBox
                                            x:Name="RaceRetryRoundsTextBox"
                                            Width="64"
                                            ToolTip="候选 IP 全部试过仍无人应答时，把同一批地址再并发试几轮（0＝立刻判死回 502）。候选 IP 从不因一次失败被拉黑，重赛只是再试一遍，专治「刚才不行、过一会又行」。" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Margin="0,4"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="重赛间隔(ms):" />
                                        <TextBox
                                            x:Name="RaceRetryDelayTextBox"
                                            Width="64"
                                            ToolTip="每轮重赛前等多久。最坏多等的时间 ≈ 轮数 ×（间隔 + 一批竞速预算），浏览器这段时间是在等响应，别设太大。" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="扫描并发数与 DNS 查询超时在「优选DNS」页填写并随扫描自动保存；这里保存的是解析与竞速参数，运行中的代理即时生效。"
                                    TextWrapping="Wrap" />

                                <WrapPanel Margin="0,12,0,0">
                                    <Button
                                        Click="SaveSettings_Click"
                                        Content="保存设置"
                                        ToolTip="校验并保存整个「设置」页（含上面的域名白名单与本页全部参数），并即时热更新运行中的代理。" />
                                </WrapPanel>

                                <Separator Margin="0,14,0,10" />

                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="MITM 根证书" />
                                <TextBlock
                                    x:Name="CertStatusText"
                                    Margin="0,6,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="根证书状态待检查"
                                    TextWrapping="Wrap" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button
                                        Margin="0,0,8,0"
                                        Click="CertInstallUser_Click"
                                        Content="安装到当前用户"
                                        ToolTip="无需管理员；Windows 会弹一次「是否信任此根证书」的确认框" />
                                    <Button
                                        Margin="0,0,8,0"
                                        Click="CertInstallMachine_Click"
                                        Content="管理员安装（全用户）"
                                        ToolTip="以管理员权限重启一个实例写入本机根存储，主程序本身仍无需管理员" />
                                    <Button
                                        Margin="0,0,8,0"
                                        Click="CertExport_Click"
                                        Content="导出 .cer"
                                        ToolTip="导出根证书公钥，供 Firefox 等使用独立证书库的浏览器手动导入" />
                                    <Button
                                        Click="CertUninstall_Click"
                                        Content="卸载证书"
                                        Style="{StaticResource DangerButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!--  ============ 关于：官网与源码。链接统一走 BrowserLauncher（见 MainWindow.Promo.cs 那条约定），不用 Process.Start 直接把 URL 交给 shell  ====  -->
                        <Border
                            MaxWidth="880"
                            Margin="4,0,4,12"
                            Padding="18,16"
                            HorizontalAlignment="Left"
                            Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="关于" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="智能IP优选加速（IPOptimize）：跑在本机的 HTTP/CONNECT 代理，只监听 127.0.0.1，给 GitHub 与 Cloudflare / CloudFront 的域名换更快的接入点——没有任何中转服务器，配置、日志、根证书都只存在本机。目前仅支持 Windows。"
                                    TextWrapping="Wrap" />
                                <!--  版本号由构造函数赋值（来源 csproj 的 <Version>），这里只放标签与一个空 Run  -->
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}">
                                    <Run Text="版本：" /><Run x:Name="AboutVersionText" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="12.5">
                                    <Run Text="官方网站："/><Hyperlink
                                        Click="AboutLink_Click"
                                        Foreground="{StaticResource AccentBrush}"
                                        NavigateUri="https://gh-go.com/">https://gh-go.com/</Hyperlink>
                                </TextBlock>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12.5">
                                    <Run Text="GitHub 源码："/><Hyperlink
                                        Click="AboutLink_Click"
                                        Foreground="{StaticResource AccentBrush}"
                                        NavigateUri="https://github.com/bebincas/IPOptimize">https://github.com/bebincas/IPOptimize</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!--
            底部状态栏 = 代理运行统计（原来这里是一句「安全：仅监听 127.0.0.1…」的固定提示，已移除，
            那句话挪到 ToolTip 的「注意」行里）。高频的「每次连接/每个请求成功」日志已降到 DEBUG（只进文件），
            实时可见性由这一行承担：MainWindow.RefreshStatsBar() 每秒刷一次，明细（每个域名的胜出 IP 与次数）在 ToolTip。
        -->
        <TextBlock
            x:Name="StatsBar"
            Grid.Row="2"
            Margin="2,13,0,0"
            Foreground="{StaticResource SecondaryTextBrush}"
            Text="运行统计：程序启动，代理未运行"
            TextTrimming="CharacterEllipsis" />

        <!--  Toast/Snackbar 容器：悬浮右下角，不参与命中测试，只用于“已保存/代理已启动”这类轻提示  -->
        <StackPanel
            x:Name="ToastHost"
            Grid.RowSpan="3"
            Width="360"
            Margin="0,0,12,52"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Panel.ZIndex="999"
            IsHitTestVisible="False" />
    </Grid>
</Window>
